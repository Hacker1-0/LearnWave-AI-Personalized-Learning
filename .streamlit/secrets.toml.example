# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml file or paste any value from it into chat.

GEMINI_API_KEY = "paste-your-gemini-key-here"

[app]
# Keep false until Google OAuth is configured. Set true before any public launch.
require_login = false
# Only these verified Google accounts receive the Premium Creator role.
creator_emails = ["your-google-email@example.com"]

# Google OIDC settings. Generate these in Google Cloud Console, not Google AI Studio.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"

[auth.google]
client_id = "replace-with-google-oauth-client-id"
client_secret = "replace-with-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
